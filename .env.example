# -------------------------------------------------------------
# Servidor MCP MVEVIP (copiar a .env; .env NO se versiona)
# -------------------------------------------------------------
PORT=6420
HOST=0.0.0.0
NODE_ENV=production

# -------------------------------------------------------------
# Seguridad (OBLIGATORIAS: sin valor por defecto, el servidor no arranca sin ellas)
#   MCP_ACCESS_KEY     clave que se escribe en la pantalla de autorización (mín. 16 caracteres)
#                      generar: openssl rand -base64 24
#   MCP_SIGNING_SECRET firma de códigos y tokens (mín. 32 caracteres, distinta de la anterior)
#                      generar: openssl rand -hex 32
#                      Rotarla invalida TODOS los tokens emitidos (revocación).
# -------------------------------------------------------------
MCP_ACCESS_KEY=
MCP_SIGNING_SECRET=
MCP_CLIENT_ID=mvevip_claude_connector

# Opcionales (separados por coma). Ya se permiten claude.ai / claude.com y localhost.
# MCP_ALLOWED_REDIRECT_URIS=
# MCP_ALLOWED_ORIGINS=
# Saltos de proxy confiables para la IP del cliente (Lambda Function URL = 1, local = 0)
TRUST_PROXY_HOPS=0

# -------------------------------------------------------------
# Base de Datos MySQL. USAR UN USUARIO CON SOLO PRIVILEGIO SELECT:
#   CREATE USER 'mcp_ro'@'%' IDENTIFIED BY '...';
#   GRANT SELECT ON mvevip_db.* TO 'mcp_ro'@'%';
# -------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=mcp_ro
DB_PASSWORD=
DB_NAME=mvevip_db
DB_CONNECTION_LIMIT=10
DB_CONNECT_TIMEOUT=10000
# '' (sin TLS) | rds (certificado de Amazon RDS) | true (CA del sistema)
DB_SSL=
