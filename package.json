{
  "name": "mvevip-mcp-server",
  "version": "1.0.0",
  "description": "Remote MCP server for MVEVIP corporate database integration with Claude Web & Desktop",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn src/index.ts",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "test:local": "powershell -ExecutionPolicy Bypass -File scripts/test_local.ps1"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "mvevip",
    "mysql",
    "docker",
    "aws"
  ],
  "author": "MVEVIP",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mysql2": "^3.12.0",
    "serverless-http": "^3.2.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3"
  }
}
