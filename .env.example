# -------------------------------------------------------------
# Configuración del Servidor MCP MVEVIP
# -------------------------------------------------------------
PORT=6420
HOST=0.0.0.0
NODE_ENV=production

# -------------------------------------------------------------
# Seguridad Obligatoria: Clave de confirmación para Claude
# Esta clave es la que se solicitará en la pantalla al registrar
# el conector en Claude.ai o Claude Desktop.
# -------------------------------------------------------------
MCP_ACCESS_KEY=mvevip_master_key_2026
MCP_CLIENT_ID=mvevip_claude_connector

# -------------------------------------------------------------
# Conexión a Base de Datos MySQL Corporativa
# -------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=mvevip_db
DB_CONNECTION_LIMIT=10
DB_CONNECT_TIMEOUT=10000

# -------------------------------------------------------------
# Configuración AWS para Despliegue
# -------------------------------------------------------------
AWS_PROFILE=marketingvip
AWS_REGION=us-west-2
AWS_LAMBDA_FUNCTION_NAME=mvevip-mcp-server
