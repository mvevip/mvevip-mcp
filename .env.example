# -------------------------------------------------------------
# Servidor MCP MVEVIP (copiar a .env; .env NO se versiona)
# -------------------------------------------------------------
PORT=6420
HOST=0.0.0.0
NODE_ENV=development

# -------------------------------------------------------------
# Seguridad (OBLIGATORIA; sin valor por defecto, el servidor no arranca sin ella)
#   MCP_SIGNING_SECRET  firma de códigos y tokens (mín. 32 caracteres): openssl rand -hex 32
#                       Rotarla invalida TODOS los tokens emitidos (revocación masiva).
# -------------------------------------------------------------
MCP_SIGNING_SECRET=
MCP_CLIENT_ID=mvevip_claude_connector

# URL pública (en producción: https://mcp.mvevip.com). Opcionales, separados por coma:
# MCP_PUBLIC_URL=
# MCP_ALLOWED_REDIRECT_URIS=
# MCP_ALLOWED_ORIGINS=
# Secreto compartido CloudFront -> servidor (solo producción con dominio propio)
# ORIGIN_VERIFY_SECRET=
TRUST_PROXY_HOPS=0

# -------------------------------------------------------------
# Base de datos de NEGOCIO (MySQL). USAR UN USUARIO CON SOLO SELECT:
#   CREATE USER 'mcp_ro'@'%' IDENTIFIED BY '...';
#   GRANT SELECT ON mvevip_db.* TO 'mcp_ro'@'%';
# -------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=mcp_ro
DB_PASSWORD=
DB_NAME=mvevip_db
DB_CONNECTION_LIMIT=10
DB_CONNECT_TIMEOUT=10000
# '' (sin TLS) | rds (certificado de Amazon RDS) | true (CA del sistema)
DB_SSL=

# -------------------------------------------------------------
# Base de datos de AUTENTICACIÓN (mismo RDS, otra base y otro usuario con ALL solo sobre ella):
#   CREATE DATABASE mvevip_mcp_auth CHARACTER SET utf8mb4;
#   CREATE USER 'mcp_auth'@'%' IDENTIFIED BY '...';
#   GRANT ALL ON mvevip_mcp_auth.* TO 'mcp_auth'@'%';
# Las tablas se crean solas al primer uso.
# -------------------------------------------------------------
AUTH_DB_NAME=mvevip_mcp_auth
AUTH_DB_USER=mcp_auth
AUTH_DB_PASSWORD=
# AUTH_DB_HOST=   (por defecto DB_HOST)

# -------------------------------------------------------------
# Correo del código de verificación
#   ses     -> Amazon SES (producción; requiere MAIL_FROM de un dominio verificado)
#   console -> imprime el código en consola (solo desarrollo; prohibido con NODE_ENV=production)
# -------------------------------------------------------------
MAIL_TRANSPORT=console
MAIL_FROM="MVEVIP <no-reply@mvevip.com>"
AWS_REGION=us-east-1
